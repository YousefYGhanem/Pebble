{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["app/**/*.ts", "app/**/*.svelte", "tests/**/*.ts", "electron.vite.config.ts", "site/**/*.ts", "site/**/*.svelte"],
  "exclude": ["site/dist"]
}
